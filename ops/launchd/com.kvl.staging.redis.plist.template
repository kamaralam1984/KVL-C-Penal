<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kvl.staging.redis</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec __REDIS_BIN__ --port 63790 --bind 127.0.0.1 --dir __KVL_HOME__/var/redis --appendonly yes --protected-mode yes</string>
  </array>
  <key>WorkingDirectory</key><string>__KVL_HOME__/var/redis</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__KVL_HOME__/var/log/redis.log</string>
  <key>StandardErrorPath</key><string>__KVL_HOME__/var/log/redis.err.log</string>
</dict>
</plist>
