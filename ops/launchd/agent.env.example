# Copy to $KVL_HOME/etc/agent.env (chmod 600). Enrol first (docs/MACOS_STAGING_SETUP.md step 8).
KVL_AGENT_API_URL=http://127.0.0.1:18000/api/v1
KVL_AGENT_DATA_DIR=__KVL_HOME__/var/agent
KVL_AGENT_HEALTH_PORT=19710
# Plain http is allowed only for loopback. Do not expose the staging API publicly.
KVL_AGENT_DRY_RUN=true
# dry_run stays true until the nginx/ssl ops are reviewed against the real Mac layout (see docs/MACOS_STAGING_SETUP.md).
