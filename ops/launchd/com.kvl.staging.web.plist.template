<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kvl.staging.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>export NODE_ENV=production API_ORIGIN=http://127.0.0.1:18000; exec npm run start -- -p 13000 -H 127.0.0.1</string>
  </array>
  <key>WorkingDirectory</key><string>__KVL_HOME__/app/frontend</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__KVL_HOME__/var/log/web.log</string>
  <key>StandardErrorPath</key><string>__KVL_HOME__/var/log/web.err.log</string>
</dict>
</plist>
