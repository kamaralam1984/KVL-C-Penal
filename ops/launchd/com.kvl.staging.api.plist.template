<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kvl.staging.api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>set -a; . __KVL_HOME__/etc/api.env; set +a; exec __KVL_HOME__/app/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 18000 --workers 1 --proxy-headers</string>
  </array>
  <key>WorkingDirectory</key><string>__KVL_HOME__/app/backend</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__KVL_HOME__/var/log/api.log</string>
  <key>StandardErrorPath</key><string>__KVL_HOME__/var/log/api.err.log</string>
</dict>
</plist>
