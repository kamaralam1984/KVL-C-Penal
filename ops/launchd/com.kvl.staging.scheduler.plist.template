<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kvl.staging.scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>set -a; . __KVL_HOME__/etc/api.env; set +a; exec __KVL_HOME__/app/backend/.venv/bin/python -m app.services.scheduler</string>
  </array>
  <key>WorkingDirectory</key><string>__KVL_HOME__/app/backend</string>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__KVL_HOME__/var/log/scheduler.log</string>
  <key>StandardErrorPath</key><string>__KVL_HOME__/var/log/scheduler.err.log</string>
</dict>
</plist>
