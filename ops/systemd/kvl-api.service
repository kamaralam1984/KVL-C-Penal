[Unit]
Description=KVL Hosting Panel API
After=network.target postgresql.service redis-server.service

[Service]
User=kvl
Group=kvl
WorkingDirectory=/opt/kvl/current/backend
EnvironmentFile=/etc/kvl/api.env
ExecStart=/opt/kvl/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kvl

[Install]
WantedBy=multi-user.target
