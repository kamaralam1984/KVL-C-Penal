# Example only. Review, test with `nginx -t`, and apply manually after owner approval.
server {
    listen 443 ssl http2;
    server_name panel.example.com;
    # ssl_certificate / ssl_certificate_key: managed by certbot

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # Metrics must never be public.
    location = /api/v1/metrics { return 404; }
}
server { listen 80; server_name panel.example.com; return 301 https://$host$request_uri; }
